# Copia este archivo como .env y rellena tus datos (.env NO se sube a git).
ELEVENLABS_API_KEY=
# Opcional: ID de las voces de ElevenLabs que quieras para el canal
# ELEVENLABS_VOZ_ES=
# ELEVENLABS_VOZ_EN=
# Opcional: velocidad de la voz (0.7 a 1.2)
# ELEVENLABS_VELOCIDAD=1.08
# Opcional: ruta a Blender si no está en el PATH
# BLENDER_PATH=
# Opcional: archivo de fuente para los textos (.ttf / .otf)
# CREADOR_FUENTE_ARCHIVO=
